# Dunia yang dijalankan build ini (lihat src/configs/worlds/)
VITE_WORLD_ID=republik-konoha

# Kosongkan dua baris Supabase di bawah => aplikasi otomatis jalan di MODE SANDBOX (localStorage)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Cloudflare Turnstile (opsional di lokal). Jika diisi, pendaftaran lewat Edge Function "register-citizen".
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# "edge" (default, wajib di production: Turnstile + rate-limit IP) atau "rpc" (langsung ke RPC
# register_citizen_direct; hanya aktif jika world_states.allow_direct_registration = true)
VITE_REGISTER_VIA=edge

# true => paksa mode sandbox walau env Supabase terisi (untuk demo lokal)
VITE_DEV_MOCK_MODE=false

# Tombol seed warga demo (HANYA mode sandbox lokal). Wajib false di production.
VITE_ENABLE_SANDBOX_SEED=false
