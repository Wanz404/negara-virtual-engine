# Salin ke worker/.env (file ini di-.gitignore). Satu file .env = satu dunia.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
WORLD_ID=republik-konoha
# Sama dengan argumen ke-3 set_world_secrets(...) — BUKAN PIN admin
ADMIN_SYNC_SECRET=
# Akun IG dunia yang followers-nya dicek (tanpa @)
IG_ACCOUNT_HANDLE=republikkonoha

# Opsional
IG_STATE_FILE=.ig_state.json
MAX_CHECKS=120
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=20
HEADLESS=true
